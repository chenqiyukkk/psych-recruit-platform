<view class="page">
  <view class="review-card panel">
    <view class="review-exp-title">实验：{{experimentTitle}}</view>

    <view class="review-section">
      <view class="review-label">评分：{{rating}} 分</view>
      <slider min="1" max="5" value="{{rating}}" show-value block-size="24" bindchange="onRatingChange" />
    </view>

    <view class="review-section">
      <view class="review-label">评价内容（选填）</view>
      <textarea
        class="review-textarea"
        value="{{comment}}"
        placeholder="写下你对研究者的评价..."
        maxlength="300"
        bindinput="onCommentInput"
      />
    </view>
  </view>

  <view class="review-submit">
    <button class="primary-button" loading="{{submitting}}" bindtap="submit">提交评价</button>
  </view>
</view>
