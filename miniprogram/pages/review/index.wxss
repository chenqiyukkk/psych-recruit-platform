.page {
  padding: 28rpx;
  min-height: 100vh;
  background: #f4f7f2;
}

.review-card {
  padding: 36rpx;
}

.review-exp-title {
  color: #68736f;
  font-size: 26rpx;
  margin-bottom: 28rpx;
}

.review-section {
  margin-top: 28rpx;
}

.review-label {
  color: #151c1a;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.review-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background: #f8f6f0;
  border-radius: 14rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.review-submit {
  margin-top: 40rpx;
}

.review-submit button {
  width: 100%;
}
