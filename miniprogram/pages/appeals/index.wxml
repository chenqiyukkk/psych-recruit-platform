<view class="page appeal-page">
  <view class="toolbar">
    <view class="title">申诉记录</view>
  </view>

  <view wx:if="{{error}}" class="empty panel">{{error}}</view>
  <view wx:if="{{!loading && appeals.length === 0 && !error}}" class="empty panel">
    暂无申诉记录
  </view>

  <view class="appeal-list">
    <view
      wx:for="{{appeals}}"
      wx:key="id"
      class="appeal-card panel"
      data-appeal="{{item}}"
      bindtap="onTapAppeal"
    >
      <view class="appeal-top">
        <view class="appeal-type">{{item.typeText}}</view>
        <view class="status {{item.statusClassName}}">{{item.statusText}}</view>
      </view>
      <view class="appeal-reason">{{item.reason || '无'}}</view>
      <view class="appeal-meta">
        <text class="appeal-time">{{item.createdAtText}}</text>
        <text wx:if="{{item.reviewComment}}" class="appeal-comment">已回复</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <!-- 浮动发起申诉按钮 -->
  <view class="fab" bindtap="onNewAppeal">
    <text class="fab-icon">+</text>
  </view>
</view>
