.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  color: #151c1a;
  font-size: 38rpx;
  font-weight: 800;
}

.form-panel {
  margin-bottom: 26rpx;
  padding: 28rpx;
}

.panel-title,
.list-title {
  color: #151c1a;
  font-size: 32rpx;
  font-weight: 800;
}

.field-label {
  margin: 22rpx 0 12rpx;
  color: #4d5854;
  font-size: 24rpx;
  font-weight: 800;
}

.picker-field,
.reason-input,
.evidence-input {
  width: 100%;
  border: 1rpx solid #e3dacb;
  border-radius: 14rpx;
  background: #fffaf0;
  color: #151c1a;
  font-size: 27rpx;
}

.picker-field {
  min-height: 84rpx;
  padding: 0 22rpx;
  line-height: 84rpx;
}

.placeholder {
  color: #8c8478;
}

.reason-input,
.evidence-input {
  min-height: 150rpx;
  padding: 20rpx 22rpx;
  line-height: 1.55;
}

.evidence-input {
  min-height: 112rpx;
}

.submit-button,
.list-title {
  margin-top: 28rpx;
}

.appeal-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.appeal-card {
  padding: 28rpx;
  transition: background 0.2s;
}

.appeal-card:active {
  background: rgba(237, 229, 216, 0.6);
}

.appeal-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.appeal-type {
  color: #151c1a;
  font-size: 30rpx;
  font-weight: 800;
  flex: 1;
}

.appeal-reason {
  margin-top: 14rpx;
  color: #4d5854;
  font-size: 26rpx;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.appeal-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.appeal-time {
  color: #7c827d;
  font-size: 23rpx;
}

.appeal-comment {
  color: #075e56;
  font-size: 22rpx;
  font-weight: 700;
  background: #dcefeb;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.loading {
  padding: 30rpx 0;
  text-align: center;
  color: #68736f;
  font-size: 26rpx;
}
