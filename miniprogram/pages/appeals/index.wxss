.appeals-page {
  padding-top: 18rpx;
}

.appeal-head {
  padding: 38rpx 34rpx 34rpx;
  border: 1rpx solid #dce7df;
  border-radius: 24rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(235, 244, 236, 0.98) 100%),
    #ffffff;
  color: #17211f;
  box-shadow: 0 18rpx 42rpx rgba(22, 63, 51, 0.08);
}

.appeal-kicker {
  color: #738a7c;
  font-size: 22rpx;
  font-weight: 800;
}

.appeal-title {
  margin-top: 16rpx;
  color: #17211f;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.25;
}

.appeal-subtitle {
  margin-top: 14rpx;
  color: #65766e;
  font-size: 26rpx;
  line-height: 1.6;
}

.form-panel {
  margin-top: 24rpx;
  padding: 30rpx;
}

.panel-title,
.list-title {
  color: #151c1a;
  font-size: 32rpx;
  font-weight: 800;
}

.field-label {
  margin: 24rpx 0 12rpx;
  color: #50615a;
  font-size: 24rpx;
  font-weight: 800;
}

.picker-field,
.reason-input,
.evidence-input {
  width: 100%;
  border: 1rpx solid #dce7df;
  border-radius: 14rpx;
  background: #f7fbf8;
  color: #1f2a26;
  font-size: 27rpx;
}

.picker-field {
  min-height: 84rpx;
  padding: 0 22rpx;
  line-height: 84rpx;
}

.placeholder {
  color: #8c9992;
}

.reason-input,
.evidence-input {
  min-height: 150rpx;
  padding: 20rpx 22rpx;
  line-height: 1.55;
}

.evidence-input {
  min-height: 112rpx;
}

.submit-button {
  margin-top: 28rpx;
}

.list-title {
  margin: 34rpx 0 18rpx;
}

.appeal-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.appeal-card {
  padding: 28rpx;
}

.appeal-card:active {
  background: rgba(241, 247, 242, 0.8);
}

.appeal-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.appeal-type {
  color: #151c1a;
  font-size: 30rpx;
  font-weight: 800;
}

.appeal-target {
  margin-top: 8rpx;
  color: #586f64;
  font-size: 23rpx;
  font-weight: 800;
}

.appeal-reason {
  margin-top: 16rpx;
  color: #52605a;
  font-size: 26rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.appeal-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.appeal-time {
  color: #74817b;
  font-size: 23rpx;
}

.appeal-comment {
  color: #586f64;
  font-size: 22rpx;
  font-weight: 700;
  background: #e8f1eb;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.loading {
  padding: 30rpx 0;
  text-align: center;
  color: #68736f;
  font-size: 26rpx;
}
