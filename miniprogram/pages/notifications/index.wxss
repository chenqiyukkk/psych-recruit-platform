.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 800;
}

.read-button {
  width: 160rpx;
}

.notification-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.notification-card {
  padding: 26rpx;
}

.notification-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.notification-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 750;
}

.unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #0f766e;
}

.notification-content {
  margin-top: 14rpx;
  color: #5d574d;
  font-size: 26rpx;
  line-height: 1.6;
}

.notification-time {
  margin-top: 14rpx;
  color: #797166;
  font-size: 23rpx;
}

.loading {
  padding: 30rpx 0;
  text-align: center;
  color: #797166;
  font-size: 26rpx;
}
