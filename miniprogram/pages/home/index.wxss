.home-page {
  padding-top: 22rpx;
}

.hero {
  padding: 36rpx 34rpx 32rpx;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #103c36 0%, #0b7a6d 64%, #e9b44c 160%);
  color: #ffffff;
  box-shadow: 0 22rpx 48rpx rgba(12, 68, 61, 0.22);
}

.hero-kicker {
  color: #f7d98c;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 14rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 26rpx;
  line-height: 1.6;
}

.hero-metrics {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.metric-chip {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.12);
}

.metric-chip.accent {
  background: rgba(233, 180, 76, 0.18);
}

.metric-number {
  font-size: 32rpx;
  font-weight: 800;
}

.metric-text {
  font-size: 22rpx;
}

.search-row {
  display: flex;
  gap: 16rpx;
  margin: 30rpx 0 26rpx;
}

.search-input {
  flex: 1;
  height: 82rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 1rpx solid #dbe7df;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.search-button {
  width: 132rpx;
  height: 82rpx;
  border-radius: 12rpx;
  background: #17211f;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 82rpx;
}

.notice {
  margin-bottom: 24rpx;
  padding: 24rpx;
  color: #9f2d2d;
  font-size: 26rpx;
}

.experiment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.experiment-card {
  padding: 30rpx;
}

.card-top,
.card-bottom,
.card-meta,
.tag-row {
  display: flex;
  align-items: center;
}

.card-top {
  justify-content: space-between;
  gap: 16rpx;
}

.card-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 750;
  line-height: 1.35;
}

.status {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
}

.status-success {
  background: #dcefeb;
  color: #0b7a6d;
}

.status-danger {
  background: #f8d9d3;
  color: #9f2d2d;
}

.status-muted {
  background: #ece5d8;
  color: #6f6a5f;
}

.card-desc {
  margin-top: 18rpx;
  color: #4f5d59;
  font-size: 26rpx;
  line-height: 1.55;
}

.card-meta {
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 18rpx;
  color: #6d7b75;
  font-size: 24rpx;
}

.card-bottom {
  justify-content: space-between;
  margin-top: 22rpx;
}

.payment {
  color: #c47f1e;
  font-size: 34rpx;
  font-weight: 800;
}

.risk {
  color: #0b7a6d;
  font-size: 24rpx;
}

.tag-row {
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 6rpx 12rpx;
  background: #edf4f0;
  border-radius: 10rpx;
  color: #4f5d59;
  font-size: 22rpx;
}

.loading {
  padding: 30rpx 0;
  text-align: center;
  font-size: 26rpx;
}
