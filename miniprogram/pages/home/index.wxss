.home-page {
  padding-top: 24rpx;
}

.hero {
  padding: 32rpx;
  background: linear-gradient(135deg, #fffaf0 0%, #e8f2ef 100%);
}

.hero-kicker {
  color: #9a6a1d;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-subtitle {
  margin-top: 16rpx;
  color: #6f6a5f;
  font-size: 26rpx;
  line-height: 1.6;
}

.search-row {
  display: flex;
  gap: 16rpx;
  margin: 28rpx 0;
}

.search-input {
  flex: 1;
  height: 78rpx;
  padding: 0 24rpx;
  background: #fffaf0;
  border: 1rpx solid #e2d7c3;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.search-button {
  width: 132rpx;
  height: 78rpx;
  border-radius: 8rpx;
  background: #24211c;
  color: #fffaf0;
  font-size: 28rpx;
  line-height: 78rpx;
}

.notice {
  margin-bottom: 24rpx;
  padding: 24rpx;
  color: #9f2d2d;
  font-size: 26rpx;
}

.experiment-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.experiment-card {
  padding: 28rpx;
}

.card-top,
.card-bottom,
.card-meta,
.tag-row {
  display: flex;
  align-items: center;
}

.card-top {
  justify-content: space-between;
  gap: 16rpx;
}

.card-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.35;
}

.status {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status-success {
  background: #dff2ed;
  color: #0f766e;
}

.status-danger {
  background: #f8d9d3;
  color: #9f2d2d;
}

.status-muted {
  background: #ece5d8;
  color: #6f6a5f;
}

.card-desc {
  margin-top: 18rpx;
  color: #5d574d;
  font-size: 26rpx;
  line-height: 1.55;
}

.card-meta {
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 18rpx;
  color: #797166;
  font-size: 24rpx;
}

.card-bottom {
  justify-content: space-between;
  margin-top: 22rpx;
}

.payment {
  color: #9a6a1d;
  font-size: 34rpx;
  font-weight: 800;
}

.risk {
  color: #0f766e;
  font-size: 24rpx;
}

.tag-row {
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 6rpx 12rpx;
  background: #f1eadf;
  border-radius: 8rpx;
  color: #5d574d;
  font-size: 22rpx;
}

.loading {
  padding: 30rpx 0;
  text-align: center;
  font-size: 26rpx;
}
