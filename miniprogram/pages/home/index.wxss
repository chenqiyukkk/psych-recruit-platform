.home-page {
  padding-top: 18rpx;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 44rpx 36rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  background:
    linear-gradient(135deg, rgba(11, 61, 55, 0.94) 0%, rgba(7, 94, 86, 0.94) 58%, rgba(178, 125, 45, 0.92) 150%),
    #075e56;
  color: #ffffff;
  box-shadow: 0 24rpx 54rpx rgba(42, 36, 22, 0.18);
}

.hero-kicker {
  color: #f7d98c;
  font-size: 22rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.25;
}

.hero-subtitle {
  width: 560rpx;
  max-width: 100%;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  line-height: 1.6;
}

.hero-metrics {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.metric-chip {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.metric-chip.accent {
  background: rgba(233, 180, 76, 0.18);
}

.metric-number {
  font-size: 32rpx;
  font-weight: 800;
}

.metric-text {
  font-size: 22rpx;
}

.search-row {
  display: flex;
  gap: 16rpx;
  margin: 30rpx 0 24rpx;
}

.search-box {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  height: 88rpx;
  padding: 0 20rpx;
  background: #fffdf7;
  border: 1rpx solid #e3dacb;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 24rpx rgba(53, 43, 28, 0.06);
}

.search-icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 16rpx;
  border: 4rpx solid #8e9a95;
  border-radius: 50%;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 28rpx;
}

.clear-button {
  width: 84rpx;
  height: 54rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #efe8db;
  color: #70685c;
  font-size: 22rpx;
  line-height: 54rpx;
}

.search-button {
  width: 132rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: #151c1a;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.notice {
  margin-bottom: 24rpx;
  padding: 24rpx;
  color: #9f2d2d;
  font-size: 26rpx;
}

.experiment-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.experiment-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
}

.card-top,
.card-bottom,
.card-meta,
.tag-row {
  display: flex;
  align-items: center;
}

.card-top {
  justify-content: space-between;
  gap: 16rpx;
}

.card-title {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 750;
  line-height: 1.35;
}

.card-desc {
  margin-top: 18rpx;
  color: #4d5854;
  font-size: 26rpx;
  line-height: 1.55;
}

.card-meta {
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 18rpx;
  color: #68736f;
  font-size: 24rpx;
}

.meta-item {
  display: flex;
  width: 100%;
  gap: 14rpx;
  line-height: 1.45;
}

.meta-label {
  flex-shrink: 0;
  width: 56rpx;
  color: #9a6516;
  font-weight: 700;
}

.meta-text {
  flex: 1;
}

.card-bottom {
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 22rpx;
}

.payment {
  color: #b27d2d;
  font-size: 34rpx;
  font-weight: 800;
}

.payment-note {
  margin-top: 2rpx;
  color: #8c8478;
  font-size: 22rpx;
}

.risk {
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: #edf4f0;
  color: #075e56;
  font-size: 24rpx;
  font-weight: 700;
}

.tag-row {
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 7rpx 14rpx;
  background: #f1eadf;
  border-radius: 999rpx;
  color: #4f5d59;
  font-size: 22rpx;
}

.loading {
  padding: 30rpx 0;
  text-align: center;
  font-size: 26rpx;
}

.error-text {
  color: #9f2d2d;
}
