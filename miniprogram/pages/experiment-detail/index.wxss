.detail-page {
  padding-bottom: 140rpx;
}

.detail-head {
  padding: 34rpx;
  background: linear-gradient(145deg, #ffffff 0%, #edf6f2 100%);
}

.title {
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.3;
}

.summary {
  margin-top: 18rpx;
  color: #4f5d59;
  font-size: 28rpx;
  line-height: 1.65;
}

.status {
  display: inline-block;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status-success {
  background: #dcefeb;
  color: #0b7a6d;
}

.status-danger {
  background: #f8d9d3;
  color: #9f2d2d;
}

.status-muted {
  background: #ece5d8;
  color: #6f6a5f;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 22rpx;
}

.info-cell {
  width: 335rpx;
  min-height: 150rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
}

.label {
  color: #6d7b75;
  font-size: 23rpx;
}

.value {
  margin-top: 12rpx;
  color: #24211c;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.45;
}

.highlight {
  color: #c47f1e;
  font-size: 32rpx;
}

.section {
  margin-top: 22rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 750;
}

.section-content {
  margin-top: 16rpx;
  color: #4f5d59;
  font-size: 27rpx;
  line-height: 1.65;
}

.apply-button {
  position: fixed;
  right: 28rpx;
  bottom: 40rpx;
  left: 28rpx;
}
