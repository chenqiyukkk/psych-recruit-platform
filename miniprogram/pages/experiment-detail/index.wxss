.detail-page {
  padding-bottom: 210rpx;
}

.detail-head {
  padding: 40rpx 34rpx 36rpx;
  border-radius: 24rpx;
  background:
    linear-gradient(135deg, rgba(255, 253, 247, 0.98) 0%, rgba(224, 238, 233, 0.98) 100%),
    #fffdf7;
  box-shadow: 0 18rpx 42rpx rgba(53, 43, 28, 0.08);
}

.title {
  margin-top: 20rpx;
  color: #151c1a;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.3;
}

.summary {
  margin-top: 18rpx;
  color: #4d5854;
  font-size: 28rpx;
  line-height: 1.65;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 22rpx;
}

.info-cell {
  width: 335rpx;
  min-height: 152rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
}

.label {
  color: #8c8478;
  font-size: 23rpx;
  font-weight: 700;
}

.value {
  margin-top: 12rpx;
  color: #151c1a;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.45;
}

.highlight {
  color: #b27d2d;
  font-size: 32rpx;
}

.section {
  margin-top: 22rpx;
  padding: 30rpx;
}

.section-title {
  color: #151c1a;
  font-size: 30rpx;
  font-weight: 800;
}

.section-content {
  margin-top: 16rpx;
  color: #4d5854;
  font-size: 27rpx;
  line-height: 1.65;
  word-break: break-word;
}

.criteria-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

.criteria-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 76rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #e3dacb;
  border-radius: 14rpx;
  background: #fffaf0;
}

.criteria-label {
  flex-shrink: 0;
  color: #075e56;
  font-size: 24rpx;
  font-weight: 800;
}

.criteria-value {
  min-width: 0;
  color: #151c1a;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.45;
  text-align: right;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.exclude-tag {
  padding: 12rpx 18rpx;
  border: 1rpx solid #ead9b5;
  border-radius: 999rpx;
  background: #fff7e8;
  color: #935f12;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.25;
}

.apply-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 247, 0.98);
  border-top: 1rpx solid #e3dacb;
  box-shadow: 0 -16rpx 42rpx rgba(53, 43, 28, 0.1);
}

.apply-price {
  color: #b27d2d;
  font-size: 34rpx;
  font-weight: 800;
}

.apply-note {
  margin-top: 4rpx;
  color: #7c827d;
  font-size: 22rpx;
}

.apply-button {
  width: 288rpx;
  flex-shrink: 0;
}
