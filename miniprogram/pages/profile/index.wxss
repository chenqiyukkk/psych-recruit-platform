.login-panel {
  padding: 42rpx 34rpx;
  background: linear-gradient(180deg, #ffffff 0%, #edf6f2 100%);
}

.login-badge {
  display: inline-block;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: #e6f0ec;
  color: #0b7a6d;
  font-size: 22rpx;
  font-weight: 700;
}

.login-title {
  margin-top: 24rpx;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.25;
}

.login-subtitle {
  margin-top: 16rpx;
  color: #6d7b75;
  font-size: 26rpx;
  line-height: 1.55;
}

.wx-login {
  margin-top: 34rpx;
}

.dev-login-toggle {
  margin-top: 18rpx;
}

.dev-login-box {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #dbe7df;
}

.form-input {
  height: 82rpx;
  margin-bottom: 18rpx;
  padding: 0 22rpx;
  background: #ffffff;
  border: 1rpx solid #dbe7df;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.profile-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 34rpx;
  background: linear-gradient(135deg, #ffffff 0%, #e8f5f1 100%);
}

.role {
  color: #0b7a6d;
  font-size: 24rpx;
  font-weight: 700;
}

.name {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.contact {
  margin-top: 10rpx;
  color: #6d7b75;
  font-size: 24rpx;
  line-height: 1.5;
}

.logout {
  width: 120rpx;
  flex-shrink: 0;
}

.metrics {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
}

.metric {
  width: 214rpx;
  min-height: 138rpx;
  padding: 22rpx 12rpx;
  text-align: center;
}

.metric-value {
  color: #c47f1e;
  font-size: 38rpx;
  font-weight: 800;
}

.metric-label {
  margin-top: 8rpx;
  color: #6d7b75;
  font-size: 22rpx;
}

.section-title {
  margin: 34rpx 0 18rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.registration-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.registration-card {
  padding: 26rpx;
}

.registration-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.registration-title {
  font-size: 30rpx;
  font-weight: 750;
}

.registration-meta {
  margin-top: 12rpx;
  color: #6d7b75;
  font-size: 24rpx;
}

.status {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status-success {
  background: #dcefeb;
  color: #0b7a6d;
}

.status-warning {
  background: #fff0c2;
  color: #c47f1e;
}

.status-danger {
  background: #f8d9d3;
  color: #9f2d2d;
}

.status-muted {
  background: #ece5d8;
  color: #6f6a5f;
}

.loading {
  padding: 30rpx 0;
  text-align: center;
  color: #6d7b75;
  font-size: 26rpx;
}
