.login-panel {
  padding: 46rpx 36rpx;
  background:
    linear-gradient(180deg, rgba(255, 253, 247, 0.98) 0%, rgba(234, 244, 239, 0.98) 100%),
    #fffdf7;
}

.login-badge {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #e0eee9;
  color: #075e56;
  font-size: 22rpx;
  font-weight: 800;
}

.login-title {
  margin-top: 26rpx;
  color: #151c1a;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.25;
}

.login-subtitle {
  margin-top: 16rpx;
  color: #68736f;
  font-size: 26rpx;
  line-height: 1.6;
}

.wx-login {
  margin-top: 34rpx;
}

.dev-login-toggle {
  margin-top: 18rpx;
}

.dev-login-box {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #e3dacb;
}

.form-input {
  height: 88rpx;
  margin-bottom: 18rpx;
  padding: 0 24rpx;
  background: #fffdf7;
  border: 1rpx solid #e3dacb;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.profile-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 36rpx;
  background:
    linear-gradient(135deg, rgba(255, 253, 247, 0.98) 0%, rgba(224, 238, 233, 0.98) 100%),
    #fffdf7;
}

.role {
  color: #075e56;
  font-size: 24rpx;
  font-weight: 800;
}

.name {
  margin-top: 8rpx;
  color: #151c1a;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.25;
}

.contact {
  margin-top: 10rpx;
  color: #68736f;
  font-size: 24rpx;
  line-height: 1.5;
}

.logout-button {
  flex-shrink: 0;
  width: 104rpx;
  height: 56rpx;
  padding: 0;
  border: 1rpx solid #d8cfc0;
  border-radius: 999rpx;
  background: #fffdf7;
  color: #70685c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.metrics {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  min-height: 138rpx;
  padding: 22rpx 12rpx;
  text-align: center;
}

.metric-value {
  color: #b27d2d;
  font-size: 38rpx;
  font-weight: 800;
}

.metric-label {
  margin-top: 8rpx;
  color: #68736f;
  font-size: 22rpx;
}

.section-title {
  margin: 34rpx 0 18rpx;
  color: #151c1a;
  font-size: 32rpx;
  font-weight: 800;
}

/* 快捷入口菜单 */
.menu-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.menu-item:active {
  background: rgba(237, 229, 216, 0.6);
}

.menu-label {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #151c1a;
  font-size: 28rpx;
  font-weight: 700;
}

.menu-arrow {
  color: #7c827d;
  font-size: 34rpx;
  font-weight: 300;
}

.badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  background: #a94134;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.registration-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.registration-card {
  padding: 28rpx;
}

.registration-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.registration-title {
  flex: 1;
  min-width: 0;
  color: #151c1a;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.registration-subtitle {
  margin-top: 10rpx;
  color: #9a6516;
  font-size: 23rpx;
  font-weight: 700;
}

.registration-meta {
  margin-top: 12rpx;
  color: #68736f;
  font-size: 24rpx;
  line-height: 1.45;
}

.loading {
  padding: 30rpx 0;
  text-align: center;
  color: #68736f;
  font-size: 26rpx;
}
