.tab-shell {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(246, 241, 232, 0) 0%, #f6f1e8 34%);
}

.tab-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(36, 31, 23, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 253, 247, 0.96);
  box-shadow: 0 18rpx 48rpx rgba(45, 37, 25, 0.16);
}

.tab-item {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 84rpx;
  border-radius: 22rpx;
  color: #7c827d;
}

.tab-item.active {
  background: #e0eee9;
  color: #075e56;
}

.tab-icon {
  position: relative;
  width: 34rpx;
  height: 34rpx;
}

.tab-mark {
  position: absolute;
  border-radius: 999rpx;
  background: currentColor;
}

.experiment .main {
  right: 0;
  bottom: 0;
  width: 24rpx;
  height: 24rpx;
}

.experiment .sub {
  top: 0;
  left: 0;
  width: 14rpx;
  height: 14rpx;
  opacity: 0.6;
}

.profile .main {
  top: 0;
  left: 9rpx;
  width: 16rpx;
  height: 16rpx;
}

.profile .sub {
  right: 2rpx;
  bottom: 0;
  left: 2rpx;
  height: 18rpx;
  border-radius: 14rpx 14rpx 8rpx 8rpx;
}

.tab-text {
  font-size: 27rpx;
  font-weight: 800;
  letter-spacing: 0;
}
