page {
  min-height: 100%;
  background: #f7f3ea;
  color: #24211c;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
input,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  border-radius: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.panel {
  background: #fffaf0;
  border: 1rpx solid #e2d7c3;
  border-radius: 8rpx;
  box-shadow: 0 16rpx 36rpx rgba(71, 55, 32, 0.08);
}

.primary-button,
.ghost-button,
.danger-button {
  min-height: 76rpx;
  padding: 0 28rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}

.primary-button {
  background: #0f766e;
  color: #fffaf0;
}

.ghost-button {
  background: #fffaf0;
  color: #0f766e;
  border: 1rpx solid #0f766e;
}

.danger-button {
  background: #9f2d2d;
  color: #fffaf0;
}

.muted {
  color: #797166;
}

.empty {
  padding: 56rpx 28rpx;
  color: #797166;
  text-align: center;
  font-size: 28rpx;
}
