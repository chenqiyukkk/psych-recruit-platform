page {
  min-height: 100%;
  background: #f4f7f2;
  color: #151c1a;
  font-family: "PingFang SC", "Microsoft YaHei", "Source Han Sans SC", sans-serif;
}

view,
text,
input,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  border-radius: 0;
  font-family: inherit;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 190rpx;
  background:
    linear-gradient(180deg, rgba(239, 247, 241, 0.92) 0%, rgba(244, 247, 242, 0.96) 420rpx),
    #f4f7f2;
}

.panel {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid #dce7df;
  border-radius: 16rpx;
  box-shadow: 0 18rpx 42rpx rgba(22, 63, 51, 0.08);
}

.primary-button,
.ghost-button,
.danger-button {
  min-height: 76rpx;
  padding: 0 28rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.primary-button {
  background: #0b6f62;
  color: #ffffff;
  box-shadow: 0 14rpx 26rpx rgba(11, 111, 98, 0.22);
}

.ghost-button {
  background: #ffffff;
  color: #0b6f62;
  border: 1rpx solid #bfd4ca;
  box-shadow: none;
}

.danger-button {
  background: #a94134;
  color: #ffffff;
}

.muted {
  color: #7c827d;
}

.empty {
  padding: 56rpx 28rpx;
  color: #7c827d;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.55;
}

.status {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

.status-success {
  background: #dcefeb;
  color: #0b6f62;
}

.status-warning {
  background: #fff1cf;
  color: #935f12;
}

.status-danger {
  background: #f8d9d3;
  color: #9f2d2d;
}

.status-muted {
  background: #e6ebe6;
  color: #64706b;
}
