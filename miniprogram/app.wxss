page {
  min-height: 100%;
  background: #f3f7f4;
  color: #17211f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
input,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  border-radius: 0;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #dbe7df;
  border-radius: 12rpx;
  box-shadow: 0 18rpx 40rpx rgba(22, 55, 49, 0.08);
}

.primary-button,
.ghost-button,
.danger-button {
  min-height: 76rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}

.primary-button {
  background: #0b7a6d;
  color: #ffffff;
}

.ghost-button {
  background: #ffffff;
  color: #0b7a6d;
  border: 1rpx solid #0b7a6d;
}

.danger-button {
  background: #b6423b;
  color: #ffffff;
}

.muted {
  color: #6d7b75;
}

.empty {
  padding: 56rpx 28rpx;
  color: #6d7b75;
  text-align: center;
  font-size: 28rpx;
}
